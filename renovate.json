{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ryanlewis/renovate-config"],
  "packageRules": [
    {
      "description": "Cargo on its own PR, separate from the web/ npm tree.",
      "matchManagers": ["cargo"],
      "groupName": "cargo",
      "groupSlug": "cargo",
      "semanticCommitType": "deps"
    },
    {
      "description": "npm (web/) on its own PR.",
      "matchManagers": ["npm"],
      "groupName": "npm",
      "groupSlug": "npm",
      "semanticCommitType": "deps"
    }
  ]
}
